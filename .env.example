ZWAPGRID_API_KEY=somevalue
ZWAPGRID_CONSENT_ID=someconsentid
ANTHROPIC_API_KEY=someotherothervalue

# Set true to hit the real Zwapgrid consent for `payment_history` while
# MOCK_MODE=true keeps every other tool + scripted demo scenario mocked.
ZWAPGRID_LIVE_PAYMENT_HISTORY=false

# Open Payments Europe (openpayments.io) sandbox app — Developer Portal ->
# Applications. NOT the Interledger/GNAP "Open Payments" (openpayments.dev),
# a different company/protocol. Used by /cases/{id}/pay (app/tools/openpayments_real.py).
OPENPAYMENTS_CLIENT_ID=somesandboxclientid
OPENPAYMENTS_CLIENT_SECRET=somesandboxclientsecret
OPENPAYMENTS_REDIRECT_URI=https://localhost:8080/